# Visalia Mesh ingestor config. Copy this file to .env and fill it in.
# Do not commit your real .env, it holds your token.

# Dashboard the ingestor sends to. A bare host works too (the scheme is added
# for you), so map.visaliamesh.com is the same as the full URL below.
INSTANCE_DOMAIN=https://map.visaliamesh.com

# Your ingestor token. Ask a Visalia Mesh admin for one.
API_TOKEN=

# How to reach the radio:
#   serial: leave blank to auto-detect, or name a port
#           (/dev/ttyUSB0, /dev/ttyACM0, COM5)
#   tcp:    192.168.1.50        (add :4403 for a non-default port)
#   ble:    AA:BB:CC:DD:EE:FF
CONNECTION=

# Which mesh this radio runs: meshtastic (default) or meshcore.
PROTOCOL=meshtastic

# Set to 1 for verbose, per-packet logging while you get set up.
DEBUG=0

# --- Optional packet filters (applied here, before anything is sent) ---

# Only forward these channel NAMES; drop everything else. Blank forwards every
# channel. Case-insensitive. Example: ALLOWED_CHANNELS=LongFast,Visalia
# ALLOWED_CHANNELS=

# Never forward these channel NAMES, even if allowed above.
# HIDDEN_CHANNELS=

# Drop anything received weaker than this signal-to-noise floor, in dB.
# Blank keeps everything.
# MIN_SNR=

# --- Optional overrides ---

# Pin this ingestor's own node id when the radio can't report it (rare). Use the
# radio's id, e.g. !cc384cc7. Auto-detection handles this on its own otherwise.
# INGESTOR_NODE_ID=

# The ingestor only ever listens, it never transmits, so this flag is a no-op.
# It is read only so an older config that still sets it keeps working.
# RX_ONLY=
