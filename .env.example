# Visalia Mesh ingestor config. Copy to .env and fill in. Don't commit .env.

# Dashboard URL to send data to.
INSTANCE_DOMAIN=https://map.visaliamesh.com

# Your ingestor token. Ask a Visalia Mesh admin for one.
API_TOKEN=

# How to reach the radio:
#   serial: blank to auto-detect, or a port (/dev/ttyUSB0, /dev/ttyACM0, COM5)
#   tcp:    192.168.1.50   (add :4403 for a non-default port)
#   ble:    AA:BB:CC:DD:EE:FF
CONNECTION=

# meshtastic (default) or meshcore
PROTOCOL=meshtastic

# 1 for verbose logging.
DEBUG=0

# --- Packet filters (potato-compatible, applied on this ingestor) ---
# Whitelist of channel NAMES; packets on any other channel are discarded.
# Blank = accept every channel. Case-insensitive. e.g. ALLOWED_CHANNELS=LongFast,Visalia
# ALLOWED_CHANNELS=
# Channel NAMES to drop when forwarding (blacklist).
# HIDDEN_CHANNELS=
# Drop packets weaker than this SNR floor in dB (blank = keep all).
# MIN_SNR=

# Coming from potato-mesh? This reads potato's env vars, so an existing potato
# .env works once INSTANCE_DOMAIN points here. Recognized: INSTANCE_DOMAIN,
# API_TOKEN, CONNECTION, PROTOCOL, DEBUG, INGESTOR_NODE_ID, ALLOWED_CHANNELS,
# HIDDEN_CHANNELS, MIN_SNR, RX_ONLY (MESH_PROTOCOL still works too). RX_ONLY is
# accepted but a no-op: this ingestor is receive-only and never transmits.
# INGESTOR_NODE_ID=      # optional, your radio's node id, e.g. !cc384cc7
